{
  "name": "looping-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && npm run bundle --workspace=@looping-agent/cli",
    "install:local-cli": "node ./scripts/install-local-cli.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint packages \"tests/e2e/*.ts\" --ext .ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "e2e:smoke": "bash tests/e2e/run-smoke-claude.sh",
    "e2e:smoke:codex": "bash tests/e2e/run-smoke-codex.sh",
    "e2e:repro": "npm run build && node tests/e2e/dist/check-reproducibility.js --runtime claude-agent-acp",
    "e2e:repro:codex": "npm run build && node tests/e2e/dist/check-reproducibility.js --runtime codex-acp",
    "release": "node ./scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.5",
    "esbuild": "^0.25.11",
    "eslint": "^8.57.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  }
}
